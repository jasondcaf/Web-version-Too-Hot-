{
  "name": "too-hot-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/sync-assets.mjs",
    "dev": "npm run assets && vite --host 0.0.0.0",
    "build": "npm run assets && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "vite": "^7.2.2"
  }
}
